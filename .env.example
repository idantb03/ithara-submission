# Set DEMO_MODE=true to run without any real API credentials
DEMO_MODE=true
USE_CLAUDE_CLASSIFIER=false

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_TOKEN=your_bearer_token
WHATSAPP_VERIFY_TOKEN=ithara_webhook_verify
WHATSAPP_APP_SECRET=your_app_secret

# Ithara API
ITHARA_API_BASE=https://api.ithara.ae
ITHARA_API_KEY=your_api_key

# Claude API (only needed if USE_CLAUDE_CLASSIFIER=true)
ANTHROPIC_API_KEY=sk-ant-your-key

# Email — SendGrid or any SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
OPS_EMAIL=ops@ithara.ae
FROM_EMAIL=bookings@ithara.ae

# Reserved for future multi-turn session support (not used by pipeline yet)
SESSION_DB_URL=sqlite+aiosqlite:///./sessions.db
